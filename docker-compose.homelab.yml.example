# Homelab Swarm stack — pulls prebuilt images from GHCR (see .github/workflows/docker-build.yml).
#
# Usage:
#   cp docker-compose.homelab.yml.example docker-compose.homelab.yml
#   # edit image owner if needed, then:
#   docker stack deploy -c docker-compose.homelab.yml nimconnect
#
# After pushing to main, CI publishes new images. Swarm does not auto-pull :latest —
# force a rollout on the manager, e.g.:
#   docker service update --with-registry-auth \
#     --image ghcr.io/<github-username>/nimconnect-frontend:<commit-sha> \
#     --force nimconnect_frontend
#
# docker-compose.homelab.yml is gitignored so your real stack stays local.
#
# Domains (DNS → Traefik):
#   nimconnect.nimiqminiapps.com      → frontend
#   api-nimconnect.nimiqminiapps.com  → backend
#
# GitHub repo variable (Settings → Actions → Variables):
#   VITE_API_BASE_URL=https://api-nimconnect.nimiqminiapps.com

services:
  postgres:
    image: postgres:16-alpine
    environment:
      - POSTGRES_USER=nimconnect
      - POSTGRES_DB=nimconnect
      # Password from Swarm secret (see `secrets:` below). For local bring-up only,
      # comment out POSTGRES_PASSWORD_FILE and set POSTGRES_PASSWORD inline instead.
      - POSTGRES_PASSWORD_FILE=/run/secrets/nimconnect_postgres_password
    secrets:
      - nimconnect_postgres_password
    volumes:
      - nimconnect_postgres_data:/var/lib/postgresql/data
    networks:
      - db-internal
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U nimconnect -d nimconnect"]
      interval: 5s
      timeout: 5s
      retries: 10
    deploy:
      restart_policy:
        condition: any
      # Local volume (no shared storage): pin Postgres to one labeled node.
      # Label exactly one Swarm node before deploy:
      #   docker node update --label-add nimconnect.pgdata=true <node>
      placement:
        constraints:
          - node.labels.nimconnect.pgdata == true

  backend:
    image: ghcr.io/<github-username>/nimconnect-backend:latest
    environment:
      - PORT=8787
      - COINGECKO_API_BASE=https://api.coingecko.com/api/v3
      - ALLOWED_ORIGIN=https://nimconnect.nimiqminiapps.com,https://nimminiapps.github.io,https://maestroi.github.io,https://nimbomber.nimiqminiapps.com,https://nimbomber.maestroi.cc,http://localhost:5173
      - BACKUP_DIR=/data/backups
      # DATABASE_URL is required. Prefer the Swarm secret below (full connection
      # string). Plain env works for local bring-up — password must match
      # nimconnect_postgres_password:
      # - DATABASE_URL=postgres://nimconnect:<password>@postgres:5432/nimconnect?sslmode=disable
      # One-shot legacy import only (first deploy with existing JSON on the
      # backups volume). Omit after import succeeds; runtime state is in Postgres.
      # - STATS_FILE=/data/backups/stats.json
      # - MARKETPLACE_FILE=/data/backups/marketplace.json
      # - MARKETPLACE_LEDGER_FILE=/data/backups/marketplace_ledger.jsonl
      # - HANDLES_FILE=/data/backups/handles.json
      # - PROFILES_DIR=/data/backups/profiles
      # - INBOX_DIR=/data/backups/inbox
      - ADMIN_ADDRESSES=<your Nimiq wallet address>  # enables /api/admin/login + GET /api/stats
      # On-chain @handle registry (defaults to NimFeed catalog; set off to disable)
      # - REGISTRY_ADDRESS=off
      # - PUBLIC_APP_ORIGIN=https://nimconnect.nimiqminiapps.com
      # Handle marketplace (buy/sell @handles) — leave ESCROW_ADDRESS unset to
      # keep marketplace routes off. The signer must be our own node (below),
      # never a public gateway: gateways expose no wallet RPCs, and this key
      # should never sit on infrastructure we don't control. NIMIQ_WALLET_KEY
      # is a Swarm secret, not a plain env var (see `secrets:` below).
      # - ESCROW_ADDRESS=<Nimiq address that holds funds mid-trade>
      # - ESCROW_SIGNER_RPC_URL=http://nimiq-node:8648
      # Required, not optional, alongside the two above — the backend refuses
      # to start without them. Must match the [rpc-server] username/password
      # set in nimconnect_nimiq_client_toml below; network isolation and the
      # methods allowlist aren't enough alone, since anything else able to
      # reach the node's port would still find a live, unlocked wallet.
      # - ESCROW_SIGNER_RPC_USER=<matches client.toml [rpc-server] username>
      # Prefer a Swarm secret for the password (env still works for local bring-up):
      # - ESCROW_SIGNER_RPC_PASSWORD=<matches client.toml [rpc-server] password>
      #   or mount secret ESCROW_SIGNER_RPC_PASSWORD under /run/secrets/
    secrets:
      - source: nimconnect_nimiq_wallet_key
        target: NIMIQ_WALLET_KEY
      - source: nimconnect_database_url
        target: DATABASE_URL
    volumes:
      - nimconnect_backups:/data/backups
    networks:
      - web
      - db-internal
      - escrow-internal
    deploy:
      placement:
        constraints:
          - node.role == worker
      restart_policy:
        condition: any
      labels:
        - traefik.enable=true
        # Multi-network service: force Traefik onto shared web, not escrow-internal.
        - traefik.docker.network=web
        - traefik.http.routers.nimconnect-api.rule=Host(`api-nimconnect.nimiqminiapps.com`)
        - traefik.http.routers.nimconnect-api.entrypoints=websecure
        - traefik.http.routers.nimconnect-api.tls=true
        - traefik.http.services.nimconnect-api.loadbalancer.server.port=8787

  # Escrow signer node — only needed if ESCROW_ADDRESS is set above. Holds the
  # unlocked escrow wallet. Lives only on the private escrow-internal overlay
  # (not on shared `web`), with no published ports and no Traefik labels.
  # Backend reaches it as http://nimiq-node:8648 and must supply matching
  # ESCROW_SIGNER_RPC_USER / ESCROW_SIGNER_RPC_PASSWORD (startup fails closed).
  nimiq-node:
    image: ghcr.io/nimiq/core-rs-albatross:1.7.1
    user: "1001:1001"
    environment:
      - RPC_ENABLED=true
      - NIMIQ_NETWORK=main-albatross
    configs:
      - source: nimconnect_nimiq_client_toml
        target: /home/nimiq/.nimiq/client.toml
    volumes:
      - nimconnect_nimiq_node_data:/home/nimiq/.nimiq
    networks:
      - escrow-internal
    deploy:
      restart_policy:
        condition: any
      placement:
        constraints:
          - node.role == worker

  frontend:
    image: ghcr.io/<github-username>/nimconnect-frontend:latest
    networks:
      - web
    deploy:
      placement:
        constraints:
          - node.role == worker
      restart_policy:
        condition: any
      labels:
        - traefik.enable=true
        - traefik.http.routers.nimconnect.rule=Host(`nimconnect.nimiqminiapps.com`)
        - traefik.http.routers.nimconnect.entrypoints=websecure
        - traefik.http.routers.nimconnect.tls=true
        - traefik.http.services.nimconnect.loadbalancer.server.port=80

networks:
  web:
    external: true
  # Private overlay for backend ↔ Postgres. Internal only — no published ports.
  db-internal:
    driver: overlay
    attachable: false
  # Private overlay for backend ↔ escrow signer. Not on shared `web`, not
  # attachable by other stacks. Not marked internal:true so the node can still
  # reach Nimiq peers for sync. Do not publish the signer port on the host.
  escrow-internal:
    driver: overlay
    attachable: false

volumes:
  nimconnect_postgres_data:
  nimconnect_backups:
  nimconnect_nimiq_node_data:

# Create before first deploy (see comments on the fields above for what each
# holds). Config content: start from the repo's nimiq/client.toml (already
# mainnet + the methods allowlist) and add [rpc-server] username/password if
# using ESCROW_SIGNER_RPC_USER/PASSWORD above.
#   echo -n '<strong-postgres-password>' | docker secret create nimconnect_postgres_password -
#   echo -n 'postgres://nimconnect:<same-password>@postgres:5432/nimconnect?sslmode=disable' \
#     | docker secret create nimconnect_database_url -
#   echo -n '<hex private key>' | docker secret create nimconnect_nimiq_wallet_key -
#   docker config create nimconnect_nimiq_client_toml - < /secure/path/client-mainnet.toml
# To rotate either, remove it only after no service references it (redeploy
# without the old service first), then create again with the same name.
secrets:
  nimconnect_postgres_password:
    external: true
  nimconnect_database_url:
    external: true
  nimconnect_nimiq_wallet_key:
    external: true

configs:
  nimconnect_nimiq_client_toml:
    external: true
